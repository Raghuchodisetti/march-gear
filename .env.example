# Copy to .env.local and fill in. Never commit real values.

# MySQL / MariaDB connection.
#   Local XAMPP:  mysql://root@localhost:3306/marchgear
#   Hosted MySQL: mysql://USER:PASSWORD@HOST:3306/DBNAME?ssl=true
DATABASE_URL=

# First admin account, created by `npm run db:seed` if it doesn't exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Encrypts dealer bank account numbers at rest. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the same key in every environment that shares a database; changing it makes stored numbers unreadable.
PARTNER_DATA_KEY=

# Demo dealership owner login for `npm run db:seed-demo` (local/dev databases only — never the live one).
# Leave the password empty to have a strong one generated and written to .env.local.
DEMO_DEALER_EMAIL=
DEMO_DEALER_PASSWORD=

# Demo insurance vendor login for `npm run db:seed-insurance` (local/dev databases only — never the live one).
# Leave the password empty to have a strong one generated and written to .env.local.
DEMO_INSURER_EMAIL=
DEMO_INSURER_PASSWORD=

# Public site address for share images and canonical links (e.g. https://march-gear.vercel.app). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=
