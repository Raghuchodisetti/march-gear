{
  "name": "march-gear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:admin": "tsx --env-file=.env.local src/db/set-admin.ts",
    "db:seed-demo": "tsx --env-file=.env.local src/db/seed-demo-dealer.ts",
    "db:seed-insurance": "tsx --env-file=.env.local src/db/seed-demo-insurance.ts",
    "db:catalogue-listings": "tsx --env-file=.env.local src/db/catalogue-listings.ts",
    "db:import-catalogue": "tsx --env-file=.env.local src/db/import-catalogue.ts",
    "db:import-images": "tsx --env-file=.env.local src/db/import-images.ts",
    "db:compress-stored": "tsx --env-file=.env.local src/db/compress-stored.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
